# ==========================================
# Application
# ==========================================
APP_NAME=Agentic AI Engineering Lab
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ==========================================
# Application URLs
# ==========================================
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:8001
API_V1_PREFIX=/api/v1

# ==========================================
# AI Providers
# ==========================================
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Google Gemini
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=agentlab
POSTGRES_USER=agentlab
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Valkey
# ==========================================
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ==========================================
# Qdrant Vector Database
# ==========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ==========================================
# SeaweedFS Object Storage
# ==========================================
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=agentlab-objects
S3_REGION=us-east-1

# ==========================================
# Langfuse - LLM Observability
# ==========================================
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ==========================================
# SeaweedFS - Single Node
# ==========================================
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333

# Host-accessible management interfaces
SEAWEEDFS_MASTER_HOST_PORT=9333
SEAWEEDFS_FILER_HOST_PORT=8888

# ==========================================
# LangGraph - Agent Execution
# ==========================================
LANGGRAPH_RECURSION_LIMIT=50
AGENT_EXECUTION_TIMEOUT=300
AGENT_MAX_CONCURRENCY=5

# ==========================================
# RAG - Document Processing
# ==========================================
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ==========================================
# Embeddings
# ==========================================
DEFAULT_EMBEDDING_PROVIDER=google
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS - Cross-Origin Access
# ==========================================
CORS_ORIGINS=http://localhost:3001

# PostgreSQL bootstrap administrator
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# Langfuse database credentials
LANGFUSE_DB_PASSWORD=

# ==========================================
# ClickHouse
# ==========================================
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

# ==========================================
# Langfuse Self-Hosted
# ==========================================
LANGFUSE_IMAGE_TAG=4
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
